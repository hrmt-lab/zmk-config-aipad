#include <behaviors.dtsi>
#include <behaviors/host_action.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                /* Row 0 sits under the four ScreenKeys. host_action 6 makes
                 * the AI session on this ScreenKey the operation target; the
                 * value is the display slot number. The packet format is
                 * unchanged and the host interprets the value. */
                &host_action 6 0    &host_action 6 1    &host_action 6 2    &host_action 6 3
                &host_action 2 0    &none               &none               &host_action 3 0
                /* RC(2,3) is the encoder position. The fitted EC12E1220301 has
                 * no push switch, so nothing ever reports there; the binding
                 * exists only to keep the 3x4 map complete. */
                &none               &none               &bootloader         &none
            >;

            sensor-bindings = <&hud_rotate>;
        };

        /* Layers 1..7 exist so the host can switch into them and so ZMK Studio
         * has something to edit: ZMK_KEYMAP_LAYERS_LEN comes from this keymap
         * and Studio can never add a layer beyond it.
         *
         * There is no layer key on this board - all eleven keys are taken - so
         * layers are activated by the host over APP_LAYER (0x30), which
         * CONFIG_RAWHID_APP_LAYER_CONTROL=y handles.
         *
         * The ScreenKey row is repeated verbatim on every layer instead of
         * being left transparent. Cycling the AI session on the screen you are
         * looking at has to keep working whatever layer the host has pushed,
         * and spelling it out means editing a lower layer in Studio cannot
         * silently take it away. Everything else is &trans so an unconfigured
         * layer behaves exactly like the layer below it.
         *
         * sensor-bindings is deliberately absent on these layers. &trans is a
         * key behavior and has no #sensor-binding-cells, so it cannot be used
         * for a sensor. A layer with no sensor binding leaves behavior_dev NULL
         * and zmk_keymap_sensor_event() walks down to the next layer, which is
         * the transparent behaviour we want: the encoder keeps falling through
         * to the default layer's &hud_rotate. */

        layer_1 {
            display-name = "Layer1";
            bindings = <
                &host_action 6 0    &host_action 6 1    &host_action 6 2    &host_action 6 3
                &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans
            >;
        };

        layer_2 {
            display-name = "Layer2";
            bindings = <
                &host_action 6 0    &host_action 6 1    &host_action 6 2    &host_action 6 3
                &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans
            >;
        };

        layer_3 {
            display-name = "Layer3";
            bindings = <
                &host_action 6 0    &host_action 6 1    &host_action 6 2    &host_action 6 3
                &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans
            >;
        };

        layer_4 {
            display-name = "Layer4";
            bindings = <
                &host_action 6 0    &host_action 6 1    &host_action 6 2    &host_action 6 3
                &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans
            >;
        };

        layer_5 {
            display-name = "Layer5";
            bindings = <
                &host_action 6 0    &host_action 6 1    &host_action 6 2    &host_action 6 3
                &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans
            >;
        };

        layer_6 {
            display-name = "Layer6";
            bindings = <
                &host_action 6 0    &host_action 6 1    &host_action 6 2    &host_action 6 3
                &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans
            >;
        };

        layer_7 {
            display-name = "Layer7";
            bindings = <
                &host_action 6 0    &host_action 6 1    &host_action 6 2    &host_action 6 3
                &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans
            >;
        };
    };

    /* Definitions live here as usual. The Keylink runtime Combo engine takes
     * them as its read-only defaults; the overlay disables the node so ZMK's
     * built-in Combo listener is not generated alongside it. There is a
     * dedicated &bootloader key on this board, so no combo is defined by
     * default; add children here if you want runtime-editable combos. */
    combos {
        compatible = "zmk,combos";
    };

    behaviors {
        /* Encoder rotation moves the HUD's decision highlight. This board's
         * encoder A/B phases make ZMK report the physical directions in
         * reverse, so the bindings intentionally map ZMK CW to previous and
         * ZMK CCW to next. Only the default layer binds this sensor and upper
         * layers fall through to it. */
        hud_rotate: hud_rotate {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&host_action 4 0>, <&host_action 5 0>;  /* ZMK CW = previous, ZMK CCW = next */
        };
    };
};
